# ============================================================================
#  .env.example — скопируйте в .env и подставьте значения.
#  Файл .env в репозиторий НЕ коммитится (см. .gitignore).
#  Пустое значение с комментарием в той же строке — только как КЛЮЧ="" # комментарий:
#  docker compose (env_file) в строке «КЛЮЧ=   # комментарий» считает значением сам
#  комментарий, и сервис в контейнере не стартует. Python (python-dotenv) читает оба вида.
#  Сборка по умолчанию рассчитана на локальный Ollama (OpenAI-совместимый API).
# ============================================================================

# --- Ollama (OpenAI-совместимый эндпоинт) ---
OPENAI_API_KEY=ollama                       # для Ollama ключ-заглушка
OPENAI_BASE_URL=http://localhost:11434/v1   # локальный эндпоинт Ollama
SUPPORT_PRIMARY_MODEL=llama3.2              # текстовая модель (чат)
SUPPORT_CLASSIFIER_MODEL=llama3.2          # модель классификатора обращений
SUPPORT_VISION_MODEL=llama3.2-vision       # vision-модель для варианта А (нужна именно vision)
#SUPPORT_VISION_MODEL=gemma3:4b       # vision-модель для варианта А (нужна именно vision)
#SUPPORT_VISION_MODEL=qwen3-vl:2b-instruct


# --- Function Calling (блок 3.1) ---
# Модель должна поддерживать tools (llama3.2, qwen2.5, qwen3 и др.; vision-модели — не все).
SUPPORT_TOOLS_MODEL=""                      # пусто => SUPPORT_PRIMARY_MODEL
SUPPORT_PRODUCT_NAME=Личный кабинет         # подставляется в app/prompts/system_v1.j2
SYSTEM_PROMPT_VERSION=v1                    # app/prompts/system_<версия>.j2
TOOLS_MAX_ROUNDS=3                          # максимум раундов с вызовом инструментов

# --- Выбор провайдера и fallback ---
LLM_PROVIDER=ollama
LLM_FALLBACK_ORDER=ollama                   # можно: ollama,openrouter,openai

# --- Надёжность ---
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=5
#LLM_MAX_RETRIES=2 # для qwen3-vl:2b-instruct

# --- Кеш ---
CACHE_TTL=3600

# --- HTTP-прокси (опционально; к localhost не применяется) ---
LLM_PROXY=""                                # http://user:pass@host:port или пусто

# --- Аудио-эндпоинт для варианта Б (Whisper + TTS) ---
# СТАТУС ВАРИАНТА Б: проработан теоретически, НЕ тестировался на реальных
# аудио-сервисах. Whisper/TTS требуют платного доступа к OpenAI API, оплата
# которого из России затруднена. Ollama аудио не поддерживает. При наличии
# ключа достаточно вписать его — код менять не нужно.
AUDIO_API_KEY=""                            # реальный ключ OpenAI для Whisper/TTS
AUDIO_BASE_URL=""                           # пусто => https://api.openai.com/v1
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy                             # alloy | echo | fable | onyx | nova | shimmer

# --- Необязательные облачные fallback-провайдеры ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- HTTP-сервис на FastAPI (блок 3.4): app/core/config.py ---
# Вложенная секция LLM задаётся с префиксом LLM__. Пустое значение = значение по умолчанию.
# Переменные выше (OPENAI_API_KEY, SUPPORT_PRIMARY_MODEL и др.) сервис не читает:
# они нужны CLI, ассистенту с инструментами и скриптам блоков 2–3.
LLM__OPENAI_API_KEY=""        # обязательно, без него сервис не стартует; для Ollama — любое непустое, например ollama
LLM__BASE_URL=""              # пусто => https://api.openai.com/v1; Ollama: http://localhost:11434/v1
LLM__DEFAULT_MODEL=""         # пусто => gpt-4o-mini; Ollama: llama3.2
LLM__REQUEST_TIMEOUT=""       # пусто => 30 (с, на одну попытку); Ollama на CPU: 120, фото на CPU (gemma3:4b): 600
LLM__MAX_RETRIES=""           # пусто => 3 (повторы SDK на 429, 5xx и ошибки соединения)
LLM__MAX_CONCURRENCY=""       # пусто => 10 (одновременных запросов к модели, Bulkhead)
REDIS_URL=""                  # пусто => redis://localhost:6379/0; в Docker compose.yaml задаёт redis://redis:6379/0
CACHE_TTL_SECONDS=""          # пусто => 3600 (сколько секунд ответ живёт в кеше)
CORS_ORIGINS=""               # пусто => ["http://localhost:3000"]; JSON-список адресов фронтенда
CORS_ALLOW_CREDENTIALS=""     # пусто => false; true нельзя сочетать с ["*"]
APP_NAME=""                   # пусто => «multapi — LLM-сервис техподдержки» (заголовок в Swagger)

# --- Docker (блок 3.5): Dockerfile и compose.yaml ---
# Файл .env в образ не попадает (.dockerignore): compose передаёт его контейнеру через env_file.
LOG_LEVEL=INFO                # уровень лога сервиса: DEBUG, INFO, WARNING, ERROR
DOCKER_LLM_BASE_URL=""        # адрес провайдера для контейнера; пусто => http://host.docker.internal:11434/v1 (Ollama на хосте)

# --- Наблюдаемость (блок 3.6): JSON-логи и трейсы в Phoenix ---
# LOG_LEVEL (выше) действует и на JSON-логи. В Docker адрес Phoenix задаёт compose.yaml
# (http://phoenix:6006) и он важнее значения отсюда.
PHOENIX_COLLECTOR_ENDPOINT="" # пусто => трейсинг выключен; локальный uvicorn + Phoenix из compose: http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=""       # пусто => diploma-fastapi (проект в интерфейсе Phoenix)
# В логах промпта нет (только prompt_hash и маскированный prompt_preview), а span
# ChatCompletion в Phoenix хранит текст запроса и ответа — для отладки. Чтобы не хранить
# там персональные данные, раскомментируйте (значения заменятся на __REDACTED__):
#OPENINFERENCE_HIDE_INPUTS=true
#OPENINFERENCE_HIDE_OUTPUTS=true
# Имена и адреса в prompt_preview (опционально, только локально — в Docker-образе пакетов нет):
# pip install -r requirements-presidio.txt
PII_PRESIDIO=""               # пусто => false; true — Presidio поверх regex, модель грузится на старте ~4 с

# --- Ассистент в /chat и оценка качества (блок 3.7) ---
# Если в запросе к /chat нет сообщения system, сервис сам добавляет промпт ассистента
# техподдержки и статьи руководства (data/knowledge_base.json), найденные по вопросу.
SUPPORT__ENABLED=""           # пусто => true; false — сообщения уходят модели как есть
SUPPORT__PRODUCT_NAME=""      # пусто => Личный кабинет (подставляется в промпт)
SUPPORT__MAX_SENTENCES=""     # пусто => 5 (предел длины ответа в промпте)

# --- Судья для eval/run_evaluation.py (блок 3.7) ---
# Учебная связка: бесплатная модель OpenRouter через прокси преподавателя.
# Ключ — учебный ключ группы OpenRouter (sk-or-v1-...), адрес прокси — из письма преподавателя:
# впишите их в .env. Ключ сюда не вносим: OpenRouter участвует в сканировании секретов
# GitHub, опубликованный ключ сочтут скомпрометированным и отзовут для всей группы,
# а GitHub может отклонить такой push.
# Бесплатные модели: 50 запросов в день на ключ (общий для группы), полный прогон — 25 запросов к судье.
# Судья — nvidia/nemotron-3-super-120b-a12b:free (им оценён полный прогон 4). Он рассуждает
# скрыто, а лимит токенов у OpenRouter общий для рассуждений и ответа — отсюда 4000.
# Другой бесплатный судья — google/gemma-4-31b-it:free с EVAL_JUDGE_REASONING=none и
# EVAL_JUDGE_MAX_TOKENS=1200; 7 октября 2026 его канал на всех попытках отвечал 429 «rate-limited upstream».
# Судья на локальной Ollama (qwen3:4b-instruct, на CPU ~37 мин на прогон): очистите
# EVAL_JUDGE_MODEL, EVAL_JUDGE_BASE_URL и EVAL_JUDGE_MAX_TOKENS.
# Проверка связи без вызова моделей: python eval/check_connection.py
EVAL_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free # пусто => qwen3:4b-instruct (Ollama)
EVAL_JUDGE_BASE_URL=https://openrouter.ai/api/v1 # пусто => LLM__BASE_URL
EVAL_JUDGE_API_KEY=""         # учебный ключ OpenRouter sk-or-v1-... — только в .env; пусто => LLM__OPENAI_API_KEY
EVAL_JUDGE_REASONING=""       # только OpenRouter, пусто => не отправлять; none — без скрытых рассуждений (gemma)
EVAL_JUDGE_MAX_TOKENS=4000    # пусто => 1200; предел длины ответа судьи вместе со скрытыми рассуждениями

# --- Сеть до внешних провайдеров LLM: OpenRouter, OpenAI (блок 3.7) ---
# Действует на судью eval и на сервис, если LLM__BASE_URL внешний. К localhost, 127.0.0.1,
# host.docker.internal (Ollama) не применяется. Не путать с LLM_PROXY выше — он для CLI блоков 2–3.
# Прокси учебной группы от преподавателя: напрямую openrouter.ai из нашей сети отвечает 403.
LLM__PROXY_URL=""             # пусто => без прокси; учебный прокси: http://логин:пароль@хост:порт (в .env)
# Сеть или антивирус проверяют HTTPS и подменяют сертификат (CERTIFICATE_VERIFY_FAILED:
# self-signed certificate in certificate chain): проверять HTTPS по хранилищу сертификатов
# ОС, как браузер (пакет truststore). Проверка не отключается и в обычной сети тоже работает.
LLM__USE_SYSTEM_CERTS=true    # пусто => false

# --- Безопасность /chat (блок 3.8) ---
# Защитный слой: проверка входа до модели, канарейка в системном сообщении, проверка ответа.
# false — «голый» сервис, только на время прогона garak baseline; потом вернуть пустое значение.
SECURITY__ENABLED=""          # пусто => true
SECURITY__MAX_INPUT_CHARS=""  # пусто => 4000; длиннее — готовый отказ без вызова модели
# Лимит запросов к /chat, /chat/stream и /chats/{id}/messages в минуту на X-User-ID или IP; счётчики — в Redis.
# На время прогонов garak — 0: в прогоне after отказы приходят мгновенно, и лимит растянул бы его на 20 минут.
RATE_LIMIT_PER_MIN=30         # пусто или 0 => без лимита; проверка: python scripts/load_test.py
# Копия JSON-лога в файл (UTF-8): по нему проверяется, что сырых email в логе нет.
LOG_FILE=""                   # пусто => только консоль; например logs/service.jsonl

# --- Чаты с историей на сервере (блок 4.1), подробно — docs/chat.md ---
# Хранилище истории: json — файлы в CHAT_STORAGE_DIR, postgres — база DATABASE_URL
# (перед первым запуском: docker compose up -d postgres, затем alembic upgrade head).
CHAT_REPOSITORY=""            # пусто => json
CHAT_STORAGE_DIR=""           # пусто => var/chats от корня проекта
# Адрес Postgres. Пусто => postgresql+asyncpg://multapi:multapi@127.0.0.1:5433/multapi —
# сервис postgres из compose.yaml. В Docker compose задаёт свой адрес (postgres:5432).
DATABASE_URL=
# Стратегия контекста: sliding — последние CHAT_CONTEXT_WINDOW сообщений (hybrid в 4.1 не реализована).
CHAT_CONTEXT_STRATEGY=""      # пусто => sliding
CHAT_CONTEXT_WINDOW=""        # пусто => 10 сообщений, не больше 48
CHAT_SYSTEM_PROMPT=""         # пусто => промпт ассистента «{product_name}» из app/core/config.py
# Бюджет токенов запроса: CONTEXT_WINDOW - RESPONSE_TOKENS - SAFETY_MARGIN. CONTEXT_WINDOW —
# окно модели; у Ollama это num_ctx (OLLAMA_CONTEXT_LENGTH), лишнее Ollama молча отрезает с начала.
CONTEXT_WINDOW=""             # пусто => 4096
RESPONSE_TOKENS=""            # пусто => 1024 (max_tokens ответа)
SAFETY_MARGIN=""              # пусто => 256; для llama3.2 и русского текста — 450 (замер в docs/chat.md)

# --- Медиа в чатах (блок 4.3): фото, голос, PDF и DOCX в POST /chats/{id}/messages ---
# Фото смотрит модель с поддержкой изображений: llama3.2 их не видит. Пусто — SUPPORT_VISION_MODEL
# (если задан выше), иначе модель по умолчанию, если она видит картинки; нет такой — фото
# получает понятный отказ. Для Ollama: ollama pull gemma3:4b (около 3,3 ГБ). На CPU gemma3:4b
# разбирает скриншот до первого слова 3–4 минуты: LLM__REQUEST_TIMEOUT=600 выше и у бота
# BACKEND_STREAM_TIMEOUT=600 ниже, иначе бот уйдёт по таймауту раньше, чем модель ответит.
CHAT_VISION_MODEL=""          # например gemma3:4b; пока фото в окне истории, чату отвечает она
# Голос — Whisper (/audio/transcriptions) по ключу AUDIO_API_KEY и адресу AUDIO_BASE_URL из
# раздела голосового пайплайна выше (блок 2.6); ключ не задан — голос получает понятный отказ.
# WHISPER_MODEL — там же (whisper-1). Подсказка языка распознавания:
AUDIO_LANGUAGE=""             # пусто => ru; auto — Whisper определит язык сам
MEDIA__MAX_IMAGE_BYTES=""     # пусто => 5242880 (5 МБ); бот сам берёт фото до 2 МБ
MEDIA__MAX_AUDIO_BYTES=""     # пусто => 20971520 (20 МБ)
MEDIA__MAX_DOCUMENT_BYTES=""  # пусто => 10485760 (10 МБ)
MEDIA__MAX_DOCUMENT_CHARS=""  # пусто => 30000: текст PDF/DOCX и расшифровки обрезается до стольких символов
MEDIA__MAX_PDF_PAGES=""       # пусто => 50
MEDIA__PARSE_TIMEOUT=""       # пусто => 30 с на разбор PDF/DOCX
MEDIA__IMAGE_TOKENS=""        # пусто => 800: сколько токенов считать за картинку в бюджете контекста

# --- Уведомления из сервиса в Telegram (блок 4.3): сервис -> POST BOT_URL/notify -> бот ---
# INTERNAL_TOKEN — общий секрет сервиса и бота (заголовок X-Internal-Token), не короче 16
# символов, только в .env. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто — /notify у бота не запускается, POST /chats/{id}/system-message отвечает 503.
INTERNAL_TOKEN=
BOT_URL=""                    # пусто => http://127.0.0.1:9000 (бот на этом же компьютере); в docker compose задан http://bot:9000

# --- Telegram-бот (блок 4.2), подробно — docs/bot.md ---
# Запуск: python -m bot, после того как поднят сервис (uvicorn app.main:app --port 8000).
# Токен от @BotFather — только в .env: .env в .gitignore, в репозиторий он не попадает.
BOT_TOKEN=""                  # обязателен; формат 123456789:AA...
BACKEND_URL=""                # пусто => http://127.0.0.1:8000 (chat-сервис блока 4.1)
BOT_ADMIN_IDS=""              # Telegram user id через запятую: им доступны /status, /stats, /users, /broadcast; пусто => никому
BACKEND_TIMEOUT=""            # пусто => 60 с: ответ на обычный запрос (/chats, /clear); подключение — 3 с
BACKEND_STREAM_TIMEOUT=""     # пусто => 120 с: ожидание первого и следующего фрагмента ответа модели (блок 4.3); фото на CPU — 600
BOT_STREAMING=""              # пусто => draft: черновик sendMessageDraft (личные чаты); edit — правки сообщения, как в 4.2
BOT_DEFAULT_USER_NAME=""      # пусто => Александра: так модель обращается к пользователю, пока он не представился; «-» — без имени
BOT_API_HOST=""               # пусто => 127.0.0.1: HTTP-API /notify слушает только этот компьютер (в Docker — 0.0.0.0)
BOT_API_PORT=""               # пусто => 9000; тот же порт, что в BOT_URL сервиса
BOT_USE_SYSTEM_CERTS=""       # пусто => true: HTTPS до Telegram по хранилищу сертификатов ОС (truststore)
BOT_EXTRA_CA_FILE=""          # пусто => только хранилище ОС; бот в Docker в сети с подменой HTTPS — certs/windows-roots.pem (docs/bot.md, «Бот в Docker»)
BOT_PROXY_URL=""              # пусто => напрямую; http://user:pass@host:port или socks5://..., если Telegram недоступен
BOT_PRODUCT_NAME=""           # пусто => Личный кабинет (название в приветствии /start)

# --- Production-обвязка (блок 4.4): модерация, admin API, оценки, рассылки ---
# Модерация вопросов и ответов в сервисе (app/moderation/). Слой 1 — ключевые слова и
# регулярные выражения из YAML, работает всегда и без сети. Слой 2 — OpenAI Moderation
# (omni-moderation-latest, бесплатный), включается отдельно и нужен ключ OpenAI.
MODERATION__ENABLED=""        # пусто => true; false — без модерации (только для отладки)
MODERATION__KEYWORDS_FILE=""  # пусто => app/moderation/moderation_keywords.yaml (путь от корня проекта)
MODERATION__OPENAI_ENABLED="" # пусто => false
MODERATION__OPENAI_API_KEY="" # пусто => AUDIO_API_KEY; только в .env
MODERATION__OPENAI_BASE_URL="" # пусто => https://api.openai.com/v1 (прокси — LLM__PROXY_URL)
MODERATION__OPENAI_MODEL=""   # пусто => omni-moderation-latest
MODERATION__THRESHOLDS=""     # пусто => решение OpenAI (flagged); свои пороги JSON: {"violence": 0.5, "self_harm": 0.2}
MODERATION__TIMEOUT=""        # пусто => 10 с на запрос к OpenAI Moderation
MODERATION__FAIL_CLOSED=""    # пусто => false: OpenAI недоступен — пропустить (ключевые слова уже проверены); true — блокировать
# Admin API сервиса (/chats/admin/stats, /users, /broadcast) — заголовок X-Admin-Token. Тот же
# токен нужен боту: /stats, /users, /broadcast и отправка рассылок из очереди. Не короче 16
# символов, только в .env: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто — admin API отвечает 503, бот рассылки не забирает.
ADMIN_TOKEN=
BOT_BROADCAST_POLL=""         # пусто => 5 с: как часто бот проверяет очередь рассылок
