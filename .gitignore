# Секреты
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-litellm/
.venv-garak/
venv/
env/

# Логи реальных прогонов (sample_run.log оставляем в репозитории)
logs/app.log
logs/tool_calls.jsonl
logs/llm_calls.jsonl
logs/service.jsonl

# История чатов в JSONL (блок 4.1, CHAT_STORAGE_DIR по умолчанию)
var/

# Генерируемые аудио-ответы
outputs/*.mp3
outputs/*.wav
!outputs/.gitkeep

# Свои образцы, сгенерированные через TTS (--make-sample).
# Эталонный samples/voice_question.wav хранится в репозитории.
samples/*.mp3

# IDE / OS
.idea/
.vscode/
.DS_Store

# Блок 4.4: корневые сертификаты Windows для бота в Docker (BOT_EXTRA_CA_FILE) — у каждого свои
certs/
